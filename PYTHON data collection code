def ensure_creator_exists(creator_wallet: str, seen_at: datetime):
    """
    Creates a creator row if this wallet has never been seen.
    We do not increase total_launches here.
    total_launches is increased only after a new launch is successfully inserted.
    """
    sql = """
    INSERT INTO creators (
        creator_wallet,
        first_seen_at,
        last_seen_at,
        total_launches,
        total_migrations
    )
    VALUES (%s, %s, %s, 0, 0)
    ON DUPLICATE KEY UPDATE
        last_seen_at = VALUES(last_seen_at)
    """

    values = (
        creator_wallet,
        seen_at,
        seen_at,
    )

    cursor.execute(sql, values)
    mydb.commit()


def increase_creator_launch_count(creator_wallet: str, seen_at: datetime):
    """
    Increases creator launch count after a new mint is saved into launches.
    """
    sql = """
    UPDATE creators
    SET 
        total_launches = total_launches + 1,
        last_seen_at = %s
    WHERE creator_wallet = %s
    """

    cursor.execute(sql, (seen_at, creator_wallet))
    mydb.commit()


def increase_creator_migration_count(creator_wallet: str, seen_at: datetime):
    """
    Increases creator migration count when one of their tokens migrates.
    """
    sql = """
    UPDATE creators
    SET 
        total_migrations = total_migrations + 1,
        last_seen_at = %s
    WHERE creator_wallet = %s
    """

    cursor.execute(sql, (seen_at, creator_wallet))
    mydb.commit()


