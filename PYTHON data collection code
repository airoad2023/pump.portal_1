# =========================
# BASIC CHECKS
# =========================

def check_required_tables():
    """
    Checks if all required tables exist before the collector starts.
    This prevents the code from running and failing later.
    """
    cursor.execute("SHOW TABLES")
    existing_tables = {row[0] for row in cursor.fetchall()}

    missing_tables = []

    for table in REQUIRED_TABLES:
        if table not in existing_tables:
            missing_tables.append(table)

    if missing_tables:
        raise Exception(f"Missing tables in database {MYSQL_CONFIG['database']}: {missing_tables}")

    print("All required tables exist.")


# =========================
# HELPER FUNCTIONS
# =========================

def now_datetime() -> datetime:
    """
    Returns current local datetime.
    We use this as received_at because PumpPortal creation messages do not always provide a clean event timestamp.
    """
    return datetime.now()


def clean_text(value: Optional[str]) -> Optional[str]:
    """
    Cleans token name/symbol:
    - Converts to string
    - Removes extra spaces
    - Converts empty text into None
    """
    if value is None:
        return None

    value = str(value).strip()

    if value == "":
        return None

    return value


def lower_text(value: Optional[str]) -> Optional[str]:
    """
    Creates lowercase version for analysis/searching.
    Example:
    'Bitcoin Coin' -> 'bitcoin coin'
    """
    value = clean_text(value)

    if value is None:
        return None

    return value.lower()


def get_launch_time_parts(received_at: datetime):
    """
    Creates useful time fields for the launches table:
    - launch_date
    - launch_hour
    - launch_day_of_week

    Python weekday:
    Monday = 0
    Sunday = 6

    Here we store:
    Monday = 1
    Sunday = 7
    """
    launch_date = received_at.date()
    launch_hour = received_at.hour
    launch_day_of_week = received_at.weekday() + 1

    return launch_date, launch_hour, launch_day_of_week


def detect_keywords(name: Optional[str], symbol: Optional[str]):
    """
    Detects simple keywords from token name and symbol.
    Returns a list of:
    (keyword, category, source_field)
    """
    detected = []

    name_clean = lower_text(name) or ""
    symbol_clean = lower_text(symbol) or ""

    for keyword, category in KEYWORD_MAP.items():
        in_name = keyword in name_clean
        in_symbol = keyword in symbol_clean

        if in_name and in_symbol:
            source_field = "both"
        elif in_name:
            source_field = "name"
        elif in_symbol:
            source_field = "symbol"
        else:
            continue

        detected.append((keyword, category, source_field))

    return detected


