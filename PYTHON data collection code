def save_raw_event(event_type: str, mint: Optional[str], received_at: datetime, data: dict) -> int:
    """
    Saves full original PumpPortal JSON into raw_events.
    This is important because even if we miss a column now, raw_json keeps everything.
    """
    sql = """
    INSERT INTO raw_events (
        event_type,
        mint,
        received_at,
        raw_json
    )
    VALUES (%s, %s, %s, %s)
    """

    values = (
        event_type,
        mint,
        received_at,
        json.dumps(data, ensure_ascii=False),
    )

    cursor.execute(sql, values)
    mydb.commit()

    return cursor.lastrowid


