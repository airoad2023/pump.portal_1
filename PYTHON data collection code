def get_duplicate_counts(name_lower: Optional[str], symbol_lower: Optional[str]):
    """
    Counts how many times this token name/symbol already appeared before this launch.
    This helps detect repeated names and copycat launches.
    """
    duplicate_name_count = 0
    duplicate_symbol_count = 0

    if name_lower:
        cursor.execute(
            """
            SELECT COUNT(*)
            FROM launches
            WHERE name_lower = %s
            """,
            (name_lower,)
        )
        duplicate_name_count = cursor.fetchone()[0]

    if symbol_lower:
        cursor.execute(
            """
            SELECT COUNT(*)
            FROM launches
            WHERE symbol_lower = %s
            """,
            (symbol_lower,)
        )
        duplicate_symbol_count = cursor.fetchone()[0]

    return duplicate_name_count, duplicate_symbol_count


def save_launch(data: dict, raw_event_id: int, received_at: datetime):
    """
    Saves new token launch data into launches.
    Also updates creators and token_keywords.
    """
    mint = data.get("mint")
    name = clean_text(data.get("name"))
    symbol = clean_text(data.get("symbol"))
    creator_wallet = data.get("traderPublicKey")

    if not mint:
        print("Skipped launch because mint is missing.")
        return

    if not creator_wallet:
        print("Skipped launch because creator wallet is missing:", mint)
        return

    name_lower = lower_text(name)
    symbol_lower = lower_text(symbol)

    launch_date, launch_hour, launch_day_of_week = get_launch_time_parts(received_at)

    duplicate_name_count, duplicate_symbol_count = get_duplicate_counts(name_lower, symbol_lower)

    ensure_creator_exists(creator_wallet, received_at)

    sql = """
    INSERT IGNORE INTO launches (
        mint,
        name,
        symbol,
        creator_wallet,
        launch_time,
        received_at,
        raw_event_id,
        name_lower,
        symbol_lower,
        launch_date,
        launch_hour,
        launch_day_of_week,
        duplicate_name_count_at_launch,
        duplicate_symbol_count_at_launch
    )
    VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
    """

    values = (
        mint,
        name,
        symbol,
        creator_wallet,
        received_at,
        received_at,
        raw_event_id,
        name_lower,
        symbol_lower,
        launch_date,
        launch_hour,
        launch_day_of_week,
        duplicate_name_count,
        duplicate_symbol_count,
    )

    cursor.execute(sql, values)
    mydb.commit()

    # rowcount = 1 means a new launch was inserted.
    # rowcount = 0 means mint already existed and was ignored.
    if cursor.rowcount == 1:
        increase_creator_launch_count(creator_wallet, received_at)
        save_token_keywords(mint, name, symbol, received_at)

        print("Saved launch:", name, "|", symbol, "|", mint)
    else:
        print("Duplicate launch ignored:", mint)


# =========================
# TOKEN KEYWORDS
# =========================

def save_token_keywords(mint: str, name: Optional[str], symbol: Optional[str], detected_at: datetime):
    """
    Saves detected token keyword themes.
    Example:
    token name = 'AI Doge'
    keywords = ai, doge
    """
    keywords = detect_keywords(name, symbol)

    if not keywords:
        return

    sql = """
    INSERT IGNORE INTO token_keywords (
        mint,
        keyword,
        category,
        source_field,
        detected_at
    )
    VALUES (%s, %s, %s, %s, %s)
    """

    for keyword, category, source_field in keywords:
        values = (
            mint,
            keyword,
            category,
            source_field,
            detected_at,
        )

        cursor.execute(sql, values)

    mydb.commit()


# =========================
# MIGRATIONS
# =========================

def save_migration(data: dict, raw_event_id: int, received_at: datetime):
    """
    Saves migration data.

    Important:
    migrations table has a foreign key to launches(mint).
    So if the migrated token was created before our collector started,
    it may not exist in launches. In that case, we store raw_events but skip migrations.
    """
    mint = data.get("mint")

    if not mint:
        print("Skipped migration because mint is missing.")
        return

    cursor.execute(
        """
        SELECT launch_time, creator_wallet
        FROM launches
        WHERE mint = %s
        LIMIT 1
        """,
        (mint,)
    )

    launch_row = cursor.fetchone()

    if not launch_row:
        print("Migration found but launch not in our database. Raw event saved only:", mint)
        return

    launch_time = launch_row[0]
    creator_wallet = launch_row[1]

    minutes_from_launch = None

    if launch_time:
        seconds = (received_at - launch_time).total_seconds()
        minutes_from_launch = int(seconds // 60)

    sql = """
    INSERT IGNORE INTO migrations (
        mint,
        migration_time,
        received_at,
        raw_event_id,
        minutes_from_launch,
        migration_status
    )
    VALUES (%s, %s, %s, %s, %s, 'confirmed')
    """

    values = (
        mint,
        received_at,
        received_at,
        raw_event_id,
        minutes_from_launch,
    )

    cursor.execute(sql, values)
    mydb.commit()

    if cursor.rowcount == 1:
        cursor.execute(
            """
            UPDATE launches
            SET 
                is_migrated = TRUE,
                migration_time = %s,
                minutes_to_migration = %s
            WHERE mint = %s
            """,
            (received_at, minutes_from_launch, mint)
        )
        mydb.commit()

        if creator_wallet:
            increase_creator_migration_count(creator_wallet, received_at)

        print("Saved migration:", mint, "| minutes from launch:", minutes_from_launch)
    else:
        print("Duplicate migration ignored:", mint)


# =========================
# EVENT HANDLER
# =========================

def handle_event(data: dict):
    """
    Decides whether a PumpPortal message is a launch or migration.
    Then saves it to the correct tables.
    """
    if data.get("message"):
        print("Info:", data.get("message"))
        return

    mint = data.get("mint")
    tx_type = data.get("txType")
    received_at = now_datetime()

    # New token creation event
    if tx_type == "create":
        raw_event_id = save_raw_event(
            event_type="launch",
            mint=mint,
            received_at=received_at,
            data=data
        )

        save_launch(
            data=data,
            raw_event_id=raw_event_id,
            received_at=received_at
        )

    # Migration event
    else:
        raw_event_id = save_raw_event(
            event_type="migration",
            mint=mint,
            received_at=received_at,
            data=data
        )

        save_migration(
            data=data,
            raw_event_id=raw_event_id,
            received_at=received_at
        )


# =========================
# MAIN WEBSOCKET COLLECTOR
# =========================

async def collect_for_5_minutes():
    """
    Connects to PumpPortal and listens for:
    - new token launches
    - migrations

    Runs for exactly 5 minutes.
    """
    start_time = asyncio.get_running_loop().time()
    end_time = start_time + RUN_TIME_SECONDS

    async with websockets.connect(PUMPPORTAL_URL) as websocket:
        print("Connected to PumpPortal WebSocket.")

        await websocket.send(json.dumps({
            "method": "subscribeNewToken"
        }))
        print("Subscribed to new token events.")

        await websocket.send(json.dumps({
            "method": "subscribeMigration"
        }))
        print("Subscribed to migration events.")

        while True:
            current_time = asyncio.get_running_loop().time()

            if current_time >= end_time:
                print("5-minute time limit reached. Stopping collector.")
                break

            remaining_time = end_time - current_time

            try:
                message = await asyncio.wait_for(
                    websocket.recv(),
                    timeout=remaining_time
                )

                data = json.loads(message)
                handle_event(data)

            except asyncio.TimeoutError:
                print("5-minute time limit reached. Stopping collector.")
                break

            except json.JSONDecodeError:
                print("Received non-JSON message:", message)

            except Exception as error:
                print("Error while processing message:", error)
                print("Message was:", message)


# =========================
# RUN PROGRAM
# =========================

try:
    check_required_tables()
    asyncio.run(collect_for_5_minutes())

finally:
    cursor.close()
    mydb.close()
    print("MySQL connection closed.")
