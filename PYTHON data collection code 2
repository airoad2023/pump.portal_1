async def snapshot_scheduler(mint: str, tracked_token_id: int):
    previous = 0

    for window in SNAPSHOT_WINDOWS:
        await asyncio.sleep(window - previous)
        save_snapshot(mint, tracked_token_id, window)
        previous = window


async def unsubscribe_after_tracking(
    websocket,
    mint: str,
    active_mints: Set[str],
    tracked_token_id_by_mint: Dict[str, int],
    launch_time_by_mint: Dict[str, float],
    trade_sequence_by_mint: Dict[str, int]
):
    await asyncio.sleep(TRACK_SECONDS)

    try:
        await websocket.send(json.dumps({
            "method": "unsubscribeTokenTrade",
            "keys": [mint]
        }))

        complete_tracked_token(mint)

        active_mints.discard(mint)
        tracked_token_id_by_mint.pop(mint, None)
        launch_time_by_mint.pop(mint, None)
        trade_sequence_by_mint.pop(mint, None)

        print("Unsubscribed and cleaned memory:", mint)

    except Exception as error:
        print("Failed to unsubscribe:", mint, "| Error:", error)


