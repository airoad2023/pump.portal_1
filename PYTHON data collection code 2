def now_datetime() -> datetime:
    return datetime.now()


def clean_text(value) -> Optional[str]:
    if value is None:
        return None

    value = str(value).strip()
    return value if value else None


def lower_text(value) -> Optional[str]:
    value = clean_text(value)
    return value.lower() if value else None


def to_float(value) -> Optional[float]:
    if value is None:
        return None

    try:
        return float(value)
    except Exception:
        return None


def to_bool(value) -> Optional[bool]:
    if value is None:
        return None

    if isinstance(value, bool):
        return value

    if isinstance(value, int):
        return bool(value)

    if isinstance(value, str):
        return value.lower() in ["true", "1", "yes"]

    return None


def get_uri_domain(uri: Optional[str]) -> Optional[str]:
    if not uri:
        return None

    try:
        parsed = urlparse(uri)
        return parsed.netloc or None
    except Exception:
        return None


def calculate_price_sol(sol_amount, token_amount) -> Optional[float]:
    sol = to_float(sol_amount)
    tokens = to_float(token_amount)

    if sol is None or tokens is None or tokens == 0:
        return None

    return sol / tokens


def get_launch_time_parts(received_at: datetime):
    launch_date = received_at.date()
    launch_hour = received_at.hour
    launch_day_of_week = received_at.weekday() + 1
    return launch_date, launch_hour, launch_day_of_week


def detect_keywords(name: Optional[str], symbol: Optional[str]):
    detected = []

    name_clean = lower_text(name) or ""
    symbol_clean = lower_text(symbol) or ""

    for keyword, category in KEYWORD_MAP.items():
        in_name = keyword in name_clean
        in_symbol = keyword in symbol_clean

        if in_name and in_symbol:
            source_field = "both"
        elif in_name:
            source_field = "name"
        elif in_symbol:
            source_field = "symbol"
        else:
            continue

        detected.append((keyword, category, source_field))

    return detected


