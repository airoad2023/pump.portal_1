def calculate_launch_score(info: Dict[str, Any]) -> Tuple[int, str]:
    score = 100
    reasons = []

    sol_amount = info.get("sol_amount") or 0
    market_cap_sol = info.get("market_cap_sol") or 0
    is_mayhem_mode = info.get("is_mayhem_mode")
    duplicate_name_count = info.get("duplicate_name_count") or 0
    duplicate_symbol_count = info.get("duplicate_symbol_count") or 0
    creator_previous_launches = info.get("creator_previous_launches") or 0
    creator_previous_migrations = info.get("creator_previous_migrations") or 0

    if sol_amount >= 10:
        score += 40
        reasons.append("sol>=10")
    elif sol_amount >= 5:
        score += 30
        reasons.append("sol>=5")
    elif sol_amount >= 1:
        score += 20
        reasons.append("sol>=1")

    if market_cap_sol >= 50:
        score += 30
        reasons.append("mc>=50")
    elif market_cap_sol >= 40:
        score += 20
        reasons.append("mc>=40")

    if creator_previous_migrations >= 1:
        score += 30
        reasons.append("creator_prev_migration")

    if duplicate_name_count <= 2:
        score += 10
        reasons.append("low_name_duplicate")

    if duplicate_symbol_count <= 2:
        score += 10
        reasons.append("low_symbol_duplicate")

    if is_mayhem_mode is True:
        score -= 30
        reasons.append("mayhem_risk")

    if sol_amount < 0.05:
        score -= 20
        reasons.append("very_low_sol")

    if duplicate_name_count >= 11:
        score -= 40
        reasons.append("extreme_name_duplicate")

    if duplicate_symbol_count >= 11:
        score -= 40
        reasons.append("extreme_symbol_duplicate")

    if creator_previous_launches >= 50 and creator_previous_migrations == 0:
        score -= 50
        reasons.append("creator_50plus_no_migration")
    elif creator_previous_launches >= 20 and creator_previous_migrations == 0:
        score -= 30
        reasons.append("creator_20plus_no_migration")

    score = max(0, min(score, 200))

    return score, ",".join(reasons)


def can_track_this_minute(tracked_timestamps: List[float], current_time: float) -> bool:
    one_minute_ago = current_time - 60

    while tracked_timestamps and tracked_timestamps[0] < one_minute_ago:
        tracked_timestamps.pop(0)

    return len(tracked_timestamps) < MAX_TRACKED_PER_MINUTE


def should_track_token(
    info: Dict[str, Any],
    total_tracked_count: int,
    active_count: int,
    tracked_names: Set[str],
    tracked_symbols: Set[str],
    tracked_timestamps: List[float],
    current_time: float
) -> Tuple[bool, int, str]:

    score, reasons = calculate_launch_score(info)

    if total_tracked_count >= MAX_TOTAL_TRACKED_TOKENS:
        return False, score, "max_total_tracked_reached"

    if active_count >= MAX_ACTIVE_TRACKED_TOKENS:
        return False, score, "max_active_tracked_reached"

    if not can_track_this_minute(tracked_timestamps, current_time):
        return False, score, "max_tracked_per_minute_reached"

    sol_amount = info.get("sol_amount") or 0
    is_mayhem_mode = info.get("is_mayhem_mode")
    duplicate_name_count = info.get("duplicate_name_count") or 0
    duplicate_symbol_count = info.get("duplicate_symbol_count") or 0
    creator_previous_launches = info.get("creator_previous_launches") or 0
    creator_previous_migrations = info.get("creator_previous_migrations") or 0
    name_lower = info.get("name_lower")
    symbol_lower = info.get("symbol_lower")

    # Hard filters based on our analysis
    if is_mayhem_mode is True:
        return False, score, "hard_reject_mayhem"

    if sol_amount < 0.5:
        return False, score, "hard_reject_sol_below_0_5"

    if duplicate_name_count >= 11:
        return False, score, "hard_reject_extreme_name_duplicate"

    if duplicate_symbol_count >= 11:
        return False, score, "hard_reject_extreme_symbol_duplicate"

    if creator_previous_launches >= 50 and creator_previous_migrations == 0:
        return False, score, "hard_reject_creator_50plus_no_migration"

    # Avoid tracking repeated themes in the same run
    if name_lower and name_lower in tracked_names:
        return False, score, "hard_reject_name_already_tracked_this_run"

    if symbol_lower and symbol_lower in tracked_symbols:
        return False, score, "hard_reject_symbol_already_tracked_this_run"

    if TEST_TRACK_FIRST_TOKEN_IF_NONE and total_tracked_count == 0:
        return True, score, "technical_test_first_token"

    if score >= MIN_TRACK_SCORE:
        return True, score, reasons

    return False, score, reasons


