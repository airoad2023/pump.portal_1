def save_migration(data: dict, raw_event_id: int, received_at: datetime):
    mint = data.get("mint")

    if not mint:
        return

    cursor.execute(
        """
        SELECT launch_time, creator_wallet
        FROM launches
        WHERE mint = %s
        LIMIT 1
        """,
        (mint,)
    )

    launch_row = cursor.fetchone()

    if not launch_row:
        print("Migration found but launch not in database. Raw saved only:", mint)
        return

    launch_time = launch_row["launch_time"]
    creator_wallet = launch_row["creator_wallet"]

    minutes_from_launch = None

    if launch_time:
        seconds = (received_at - launch_time).total_seconds()
        minutes_from_launch = int(seconds // 60)

    sql = """
    INSERT IGNORE INTO migrations (
        mint,
        migration_time,
        received_at,
        raw_event_id,
        minutes_from_launch,
        migration_status
    )
    VALUES (%s, %s, %s, %s, %s, 'confirmed')
    """

    cursor.execute(sql, (mint, received_at, received_at, raw_event_id, minutes_from_launch))
    mydb.commit()

    if cursor.rowcount == 1:
        cursor.execute(
            """
            UPDATE launches
            SET
                is_migrated = TRUE,
                migration_time = %s,
                minutes_to_migration = %s
            WHERE mint = %s
            """,
            (received_at, minutes_from_launch, mint)
        )
        mydb.commit()

        cursor.execute(
            """
            UPDATE pump_tracked_tokens
            SET
                did_migrate = TRUE,
                migration_time = %s,
                seconds_to_migration = TIMESTAMPDIFF(SECOND, launch_time, %s)
            WHERE mint = %s
            """,
            (received_at, received_at, mint)
        )
        mydb.commit()

        if creator_wallet:
            increase_creator_migration_count(creator_wallet, received_at)

        print("Saved migration:", mint, "| minutes:", minutes_from_launch)


