        total_migrations
    )
    VALUES (%s, %s, %s, 0, 0)
    ON DUPLICATE KEY UPDATE
        last_seen_at = VALUES(last_seen_at)
    """

    cursor.execute(sql, (creator_wallet, seen_at, seen_at))
    mydb.commit()


