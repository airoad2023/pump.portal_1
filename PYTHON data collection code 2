async def main_collector():
    if not PUMPPORTAL_API_KEY or PUMPPORTAL_API_KEY == "YOUR_PUMPPORTAL_API_KEY":
        raise Exception("Add your real PumpPortal API key before running.")

    tracked_token_id_by_mint = {}
    launch_time_by_mint = {}
    trade_sequence_by_mint = {}

    total_tracked_count = 0
    active_mints: Set[str] = set()

    tracked_names: Set[str] = set()
    tracked_symbols: Set[str] = set()
    tracked_timestamps: List[float] = []

    paid_trade_message_count = 0
    pending_tasks = []

    start_time = asyncio.get_running_loop().time()
    end_time = start_time + LAUNCH_COLLECTION_SECONDS

    async with websockets.connect(PUMPPORTAL_URL) as websocket:
        print("Connected to PumpPortal WebSocket with API key.")

        await websocket.send(json.dumps({"method": "subscribeNewToken"}))
        print("Subscribed to new token events.")

        await websocket.send(json.dumps({"method": "subscribeMigration"}))
        print("Subscribed to migration events.")

        while True:
            current_time = asyncio.get_running_loop().time()
            launch_window_open = current_time < end_time

            # Stop only when the launch window has closed and no active paid tokens remain
            if not launch_window_open and len(active_mints) == 0:
                print("Launch window closed and no active tracked tokens remain.")
                break

            try:
                message = await asyncio.wait_for(websocket.recv(), timeout=5)
                data = json.loads(message)

            except asyncio.TimeoutError:
                continue

            except json.JSONDecodeError:
                print("Received non-JSON message.")
                continue

            except Exception as error:
                print("WebSocket error:", error)
                continue

            if data.get("message"):
                print("Info:", data.get("message"))
                continue

            tx_type = data.get("txType")
            mint = data.get("mint")
            received_at = now_datetime()

            if not mint:
                print("Skipped message without mint:", data)
                continue

            # New token launch
            if tx_type == "create":
                # After the 1-hour launch window, ignore new launches but keep receiving active trades
                if not launch_window_open:
                    continue

                raw_event_id = save_raw_event("launch", mint, received_at, data)
                launch_info = save_launch(data, raw_event_id, received_at)

                if not launch_info:
                    continue

                launch_time_by_mint[mint] = time.time()
                trade_sequence_by_mint[mint] = 0

                should_track, launch_score, reason = should_track_token(
                    launch_info,
                    total_tracked_count,
                    len(active_mints),
                    tracked_names,
                    tracked_symbols,
                    tracked_timestamps,
                    current_time
                )

                print(
                    "Score:",
                    launch_score,
                    "| track:",
                    should_track,
                    "| reason:",
                    reason,
                    "| mint:",
                    mint,
                )

                if should_track:
                    tracked_token_id = insert_tracked_token(
                        launch_info,
                        launch_score,
                        reason
                    )

                    if tracked_token_id:
                        await websocket.send(json.dumps({
                            "method": "subscribeTokenTrade",
                            "keys": [mint]
                        }))

                        tracked_token_id_by_mint[mint] = tracked_token_id
                        active_mints.add(mint)
                        total_tracked_count += 1
                        tracked_timestamps.append(current_time)

                        if launch_info.get("name_lower"):
                            tracked_names.add(launch_info["name_lower"])

                        if launch_info.get("symbol_lower"):
                            tracked_symbols.add(launch_info["symbol_lower"])

                        print(
                            "Subscribed to PAID trades:",
                            mint,
                            "| total tracked:",
                            total_tracked_count,
                            "| active:",
                            len(active_mints)
                        )

                        pending_tasks.append(asyncio.create_task(
                            snapshot_scheduler(mint, tracked_token_id)
                        ))

                        pending_tasks.append(asyncio.create_task(
                            unsubscribe_after_tracking(
                                websocket,
                                mint,
                                active_mints,
                                tracked_token_id_by_mint,
                                launch_time_by_mint,
                                trade_sequence_by_mint
                            )
                        ))

            # Paid token trade
            elif tx_type in ["buy", "sell"]:
                if mint in tracked_token_id_by_mint:
                    paid_trade_message_count += 1

                    save_token_trade(
                        data,
                        tracked_token_id_by_mint,
                        launch_time_by_mint,
                        trade_sequence_by_mint
                    )

                    if paid_trade_message_count % 100 == 0:
                        estimated_sol_used = paid_trade_message_count * 0.000001
                        print(
                            "Paid messages:",
                            paid_trade_message_count,
                            "| estimated SOL used:",
                            round(estimated_sol_used, 6)
                        )

            # Migration or unknown event
            else:
                raw_event_id = save_raw_event("migration", mint, received_at, data)
                save_migration(data, raw_event_id, received_at)

        if pending_tasks:
            print("Waiting for snapshot/unsubscribe tasks to finish...")
            await asyncio.gather(*pending_tasks, return_exceptions=True)

        estimated_sol_used = paid_trade_message_count * 0.000001
        print("Collector finished.")
        print("Total paid trade messages:", paid_trade_message_count)
        print("Estimated SOL used:", round(estimated_sol_used, 6))
        print("Total tracked tokens:", total_tracked_count)


