    )
    VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
    """

    values = (
        COLLECTION_RUN_ID,
        tracked_token_id_by_mint.get(mint),
        signature,
        mint,
        data.get("traderPublicKey"),
        tx_type,
