def get_creator_previous_stats(creator_wallet: Optional[str]) -> Tuple[int, int]:
    if not creator_wallet:
        return 0, 0

    cursor.execute(
        """
        SELECT total_launches, total_migrations
        FROM creators
        WHERE creator_wallet = %s
        LIMIT 1
        """,
        (creator_wallet,)
    )

    row = cursor.fetchone()

    if not row:
        return 0, 0

    return int(row["total_launches"] or 0), int(row["total_migrations"] or 0)


def ensure_creator_exists(creator_wallet: str, seen_at: datetime):
    sql = """
    INSERT INTO creators (
        creator_wallet,
        first_seen_at,
        last_seen_at,
