        total_volume_sol,
        buy_volume_sol,
        sell_volume_sol,
        net_volume_sol,

        average_buy_sol,
        average_sell_sol,
        largest_buy_sol,
        largest_sell_sol,

        start_market_cap_sol,
        current_market_cap_sol,
        highest_market_cap_sol,
        lowest_market_cap_sol,
        market_cap_change_sol,
        market_cap_change_percent,

        buy_sell_ratio,
        buy_volume_sell_volume_ratio,

        volume_speed_sol_per_second,
        trade_speed_per_second,
        buy_speed_per_second,
        sell_speed_per_second,

        first_trade_seconds,
        first_buy_seconds,
        first_sell_seconds,

        creator_buy_count,
        creator_sell_count,
        creator_buy_volume_sol,
        creator_sell_volume_sol,
        creator_sold,

        top_buyer_sol,
        top_seller_sol,
        top_buyer_share_percent,
        top_seller_share_percent,

        has_large_buy,
        has_large_sell,
        is_high_activity,
        is_sell_pressure_high,
        has_no_sells,

